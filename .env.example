# Create a local .env file from this template and add your own key.
# Never commit .env or share your API key.
GEMINI_API_KEY=PASTE_YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-3.8-flash

# Optional runtime settings:
# OPTMASTER_EXECUTOR=docker
# OPTMASTER_TIMEOUT_SECONDS=30
# OPTMASTER_MAX_REPAIRS=2
# OPTMASTER_PARALLELISM=1
